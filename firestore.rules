rules_version = '2';

// Learn Smart Hub - Firestore security rules
//
// The website no longer talks to Firestore at all. Premium status, plan choice
// and every M-Pesa write happen on the backend, which uses the Firebase Admin
// SDK and is not subject to these rules. So the correct rule set is: no client
// access, anywhere. A student cannot read or forge premium_access from a
// browser, and nothing breaks when this is deployed.
//
// Model for reference: a single collection, premium_access, one document per
// Firebase user, keyed by UID, with userId / plan / price / status. Only the
// backend writes `status`, and only after Safaricom confirms an M-Pesa payment.

service cloud.firestore {
  match /databases/{database}/documents {

    // Explicit, not accidental: premium_access is backend-only.
    match /premium_access/{uid} {
      allow read, write: if false;
    }

    match /mpesa_payments/{checkoutRequestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
